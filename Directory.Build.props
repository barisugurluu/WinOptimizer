<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Statik analiz — master plan Bölüm 18.3 (Roslyn analyzer kapısı). -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <Authors>WinOptimizer Team</Authors>
    <Product>WinOptimizer</Product>
    <!-- SÜRÜMÜN TEK KAYNAĞI. Installer (build/build-installer.ps1 bu dosyayı XML olarak okur),
         winget manifestleri ve GitHub Release etiketi buradan türetilir. Başka hiçbir yerde
         sürüm sabiti tutulmaz — eskiden .iss, Product.wxs ve winget yaml'larında elle
         senkronize edilen 4 kopya vardı ve senkronsuzdular.
         VersionPrefix sayısal kısımdır (installer VersionInfo alanları için zorunlu),
         VersionSuffix ise yalnız bilgilendirme amaçlıdır (0.1.0-alpha). -->
    <VersionPrefix>0.1.0</VersionPrefix>
    <VersionSuffix>alpha</VersionSuffix>
    <AssemblyVersion>$(VersionPrefix).0</AssemblyVersion>
    <FileVersion>$(VersionPrefix).0</FileVersion>
    <Copyright>Copyright © 2026 WinOptimizer</Copyright>
    <!-- Tekrarlanabilir (deterministic) derleme — master plan Bölüm 20.1 -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <!-- Source Link — stack trace'leri GitHub kaynağına bağlar (Bölüm 20.1). -->
    <RepositoryUrl>https://github.com/barisugurluu/WinOptimizer</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!-- Source Link yalnızca SDK-style C# projelerinde etkindir (WiX .wixproj hariç). -->
  <ItemGroup Condition="'$(MSBuildProjectExtension)' == '.csproj' And '$(DisableSourceLink)' != 'true'">
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
    <!-- Statik analiz eklentisi — Roslynator kod kalitesi kuralları (master plan §18.3). -->
    <PackageReference Include="Roslynator.Analyzers" Version="4.12.9" PrivateAssets="All" />
  </ItemGroup>

</Project>
