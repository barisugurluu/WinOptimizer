<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Authors>WinOptimizer Team</Authors>
    <Product>WinOptimizer</Product>
    <Version>0.1.0-alpha</Version>
    <Copyright>Copyright © 2026 WinOptimizer</Copyright>
    <!-- Tekrarlanabilir (deterministic) derleme — master plan Bölüm 20.1 -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <!-- Source Link — stack trace'leri GitHub kaynağına bağlar (Bölüm 20.1).
         Repo URL'ini gerçek adresinizle güncelleyin. -->
    <RepositoryUrl>https://github.com/WinOptimizer/WinOptimizer</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!-- Source Link yalnızca SDK-style C# projelerinde etkindir (WiX .wixproj hariç). -->
  <ItemGroup Condition="'$(MSBuildProjectExtension)' == '.csproj' And '$(DisableSourceLink)' != 'true'">
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
  </ItemGroup>

</Project>
