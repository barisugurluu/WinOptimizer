{
  "schemaVersion": 1,
  "tweaks": [
    {
      "id": "NtfsDisable8dot3",
      "name": "NTFS 8.3 kısa isim oluşturmayı kapat",
      "category": "FileSystem",
      "risk": "Medium",
      "apply": { "type": "Registry", "hive": "HKLM", "path": "SYSTEM\\CurrentControlSet\\Control\\FileSystem", "name": "NtfsDisable8dot3NameCreation", "value": 1 },
      "description": "Dizin tarama hızını artırır (eski 16-bit uygulamaları etkileyebilir)."
    },
    {
      "id": "NtfsDisableLastAccess",
      "name": "NTFS LastAccess güncellemesini kapat",
      "category": "FileSystem",
      "risk": "Low",
      "apply": { "type": "Registry", "hive": "HKLM", "path": "SYSTEM\\CurrentControlSet\\Control\\FileSystem", "name": "NtfsDisableLastAccessUpdate", "value": 1 },
      "description": "Yazma I/O'sunu azaltır."
    },
    {
      "id": "MenuShowDelay",
      "name": "Menü gösterim gecikmesini sıfırla",
      "category": "Visual",
      "risk": "Low",
      "apply": { "type": "Registry", "hive": "HKCU", "path": "Control Panel\\Desktop", "name": "MenuShowDelay", "value": "0" },
      "description": "Menüler anında açılır."
    },
    {
      "id": "SystemUsesTransparency",
      "name": "Pencere şeffaflığını kapat",
      "category": "Visual",
      "risk": "Low",
      "apply": { "type": "Registry", "hive": "HKCU", "path": "SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Themes\\Personalize", "name": "EnableTransparency", "value": 0 },
      "description": "CPU/GPU tasarrufu."
    },
    {
      "id": "TelemetryAllow",
      "name": "Telemetri düzeyini en aza indir",
      "category": "Privacy",
      "risk": "Low",
      "apply": { "type": "Registry", "hive": "HKLM", "path": "SOFTWARE\\Policies\\Microsoft\\Windows\\DataCollection", "name": "AllowTelemetry", "value": 0 },
      "description": "Microsoft'a giden tanılama verisini en aza indirir."
    }
  ]
}
