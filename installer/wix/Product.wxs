<?xml version="1.0" encoding="utf-8"?>
<!--
  WinOptimizer — WiX v4 MSI kaynağı (master plan Bölüm 20.3).
  App + Service + CLI tek per-machine kurulumda. Service LocalSystem olarak kurulur.

  Derleme:
    1) dotnet publish WinOptimizer.sln -c Release -o <publish>
    2) wix heat dir <publish> -cg PayloadFiles -dr INSTALLFOLDER -scom -sreg -srd -gg -out Payload.wxs
    3) dotnet build installer\wix\WinOptimizer.wixproj -c Release

  Heat adımı build-installer.ps1 tarafından otomatik yapılır.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
    Name="WinOptimizer"
    Manufacturer="WinOptimizer Team"
    Language="1055"
    Version="0.1.0"
    UpgradeCode="{8F4E2A1B-3C5D-4E6F-90A1-2B3C4D5E6F70}">

    <!-- Türkçe (TR) varsayılan dil; Codepage 1254 (Türkçe Windows). -->
    <SummaryInformation
      Description="WinOptimizer $(sys.SYSTEMSHORTVERSION) Kurulum"
      Manufacturer="WinOptimizer Team"
      Codepage="1254" />

    <!-- Major upgrade: aynı makinede tek sürüm; eskiyi otomatik kaldırır. -->
    <MajorUpgrade
      DowngradeErrorMessage="Daha yeni bir WinOptimizer sürümü zaten kurulu. Önce onu kaldırın."
      AllowSameVersionUpgrades="yes" />

    <Media Id="1" Cabinet="WinOptimizer.cab" EmbedCab="yes" CompressionLevel="high" />

    <!-- Klasik InstallDir sihirbazı (hedef klasör seçimi). -->
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <UI>
      <UIRef Id="WixUI_InstallDir" />
      <UIRef Id="WixUI_FeatureTree" />
      <Publish Dialog="LicenseAgreementDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" />
    </UI>

    <!-- EULA (master plan §22 — kullanım koşulları). Boşsa atlanır. -->
    <WixVariable Id="WixUILicenseRtf" Value="$(sys.SOURCEFILEDIR)license.rtf" Overridable="yes" />
    <WixVariable Id="WixUIDialogBmp" Value="$(sys.SOURCEFILEDIR)dialog.bmp" Overridable="yes" />

    <!-- Feature ağacı: Uygulama (zorunlu) + Servis (opsiyonel, varsayılan açık). -->
    <Feature Id="Complete" Title="WinOptimizer" Level="1" Display="expand" AllowAdvertise="no">
      <Feature Id="AppFeature" Title="WinOptimizer Uygulaması" Level="1" Absent="disallow">
        <ComponentGroupRef Id="PayloadFiles" />
      </Feature>
      <Feature Id="ServiceFeature" Title="RealtimeGuard Servisi" Level="1" Description="Arka plan gerçek zamanlı koruma servisi (LocalSystem)">
        <ComponentRef Id="ServiceRegistryComp" />
      </Feature>
    </Feature>

    <!-- sc.exe ile servis kur/kaldır (Inno Setup yaklaşımıyla birebir; en az kırılgan).
         Kurulum elevated (PrivilegesRequired=admin) olduğundan sc.exe başarılı çalışır. -->
    <Property Id="SC_EXE" Value="sc.exe" />

    <CustomAction Id="InstallService"
                  Property="SC_EXE"
                  ExeCommand='create WinOptimizerGuard binPath= "[INSTALLFOLDER]WinOptimizer.Service.exe" start= auto'
                  Execute="deferred" Return="check" Impersonate="no" />
    <CustomAction Id="DescribeService"
                  Property="SC_EXE"
                  ExeCommand='description WinOptimizerGuard "WinOptimizer gerçek zamanlı koruma servisi"'
                  Execute="deferred" Return="ignore" Impersonate="no" />
    <CustomAction Id="StartService"
                  Property="SC_EXE"
                  ExeCommand='start WinOptimizerGuard'
                  Execute="deferred" Return="ignore" Impersonate="no" />
    <CustomAction Id="StopService"
                  Property="SC_EXE"
                  ExeCommand='stop WinOptimizerGuard'
                  Execute="deferred" Return="ignore" Impersonate="no" />
    <CustomAction Id="DeleteService"
                  Property="SC_EXE"
                  ExeCommand='delete WinOptimizerGuard'
                  Execute="deferred" Return="ignore" Impersonate="no" />

    <InstallExecuteSequence>
      <!-- ServiceFeature install: oluştur → tanımla → başlat. -->
      <Custom Action="InstallService" After="InstallFiles" Condition="NOT Installed AND (&amp;ServiceFeature = 3)" />
      <Custom Action="DescribeService" After="InstallService" Condition="NOT Installed AND (&amp;ServiceFeature = 3)" />
      <Custom Action="StartService" After="DescribeService" Condition="NOT Installed AND (&amp;ServiceFeature = 3)" />
      <!-- Kaldırma: durdur → sil. -->
      <Custom Action="StopService" Before="RemoveFiles" Condition="REMOVE~=&quot;ALL&quot;" />
      <Custom Action="DeleteService" After="StopService" Condition="REMOVE~=&quot;ALL&quot;" />
    </InstallExecuteSequence>
  </Package>

  <!-- Hedef: %ProgramFiles%\WinOptimizer (per-machine, 64-bit). -->
  <Fragment>
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="WinOptimizer" />
    </StandardDirectory>
  </Fragment>

  <!-- ServiceFeature seçiliyse bir registry anahtarı bırakır (feature tracking).
       Payload (Service.exe dahil) PayloadFiles component grubundan gelir. -->
  <Fragment>
    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="ServiceRegistryComp" Guid="{9A5B3C7D-1E2F-4A6B-8C9D-0E1F2A3B4C5D}" Bitness="always64">
        <RegistryValue Root="HKLM" Key="SOFTWARE\WinOptimizer" Name="ServiceInstalled" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>
  </Fragment>
</Wix>
