<?xml version="1.0" encoding="utf-8"?>
<!-- WinOptimizer - WiX v4 SDK-style proje (Bolum 20.3). -->
<Project Sdk="WixToolset.Sdk/4.0.5">

  <PropertyGroup>
    <OutputName>WinOptimizer</OutputName>
    <OutputType>Package</OutputType>
    <Platform>x64</Platform>
    <!-- publish klasoru (build-installer.ps1 veya -p:PublishSourceDir ile override). -->
    <PublishSourceDir Condition=" '$(PublishSourceDir)' == '' ">$(MSBuildThisFileDirectory)..\..\src\WinOptimizer.App\bin\Release\net8.0-windows\publish\</PublishSourceDir>
    <DefineConstants>PublishSourceDir=$(PublishSourceDir)</DefineConstants>
    <SuppressIces>ICE61</SuppressIces>
  </PropertyGroup>

  <!-- Payload.wxs build oncesi generate-payload.ps1 tarafindan uretilir (heat alternatifi).
       WiX v4 wix CLI heat sikintili oldugundan PowerShell generator kullaniriz. -->

</Project>
