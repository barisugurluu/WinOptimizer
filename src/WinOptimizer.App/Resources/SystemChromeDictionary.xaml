<!--
  ============================================================================
  WPF-UI TEMA MUAFİYETİ — açık zeminli, "her koşulda çalışmak zorunda" pencereler için.

  SORUN: App.xaml'in merge ettiği <ui:ControlsDictionary />, WPF-UI 3.0.5'in kaynak
  sözlüğüdür ve yalnız ui:* kontrollerini değil YEREL WPF tiplerini de örtük (keyless)
  stille kaplar — DLL'den çıkarılan listede 96 tip var: Button, CheckBox, TextBox,
  Expander, ScrollViewer, TextBlock, hatta System.Windows.Window.

  Koyu temada bu stillerin çözülen değerleri:
      ButtonForeground   = #FFFFFFFF   (saf beyaz)
      ButtonBackground   = #0FFFFFFF   (%6 beyaz)
      CheckBoxForeground = #FFFFFFFF
  Hata penceresi / ilk açılış penceresi ise bilinçli olarak sistem renklerini zorluyor:
      SystemColors.WindowBrush = #FFFFFFFF
  Sonuç: BEYAZ ZEMİNDE BEYAZ YAZI. Düğmeler ve onay kutusu etiketleri görünmez olur.
  (Windows Sandbox'ta canlı doğrulandı: kullanıcı ilk açılış ekranından ilerleyemedi.)

  TextBlock'ların görünmesi ama düğmelerin görünmemesi kafa karıştırıcıydı: WPF-UI'ın
  TextBlock stili Foreground SET ETMİYOR (yalnız FontSize/FontWeight), o yüzden TextBlock
  pencereden siyahı miras alıyor. Button/CheckBox/TextBox/Expander ise Foreground set ediyor.

  ÇÖZÜM: Aşağıdaki BOŞ örtük stiller. WPF'te bir kontrolün Template'i "theme style"dan
  (Aero2/generic.xaml) gelir; örtük Style yalnızca ÖZELLİK geçersiz kılar. Pencere
  kapsamındaki boş bir stil, Application kapsamındaki WPF-UI stilini gölgeler ve kontrol
  WPF'in yerleşik, SystemColors tabanlı şablonuna döner.

  KULLANIM: düz System.Windows.Window + SystemColors kullanan HER pencere bunu merge
  ETMEK ZORUNDADIR:
      <Window.Resources>
          <ResourceDictionary Source="pack://application:,,,/Resources/SystemChromeDictionary.xaml" />
      </Window.Resources>

  ui:FluentWindow tabanlı pencerelere (MainWindow ve sekmeleri) UYGULANMAZ — onlar koyu
  temayı ve ui:Button'ları bilerek kullanıyor.
  ============================================================================
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Foreground setter'ları emniyet kemeridir: yerleşik Aero2 şablonu zaten
         SystemColors kullanır, ama araya başka bir sözlük girerse kontrast yine garanti. -->

    <Style TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
    </Style>

    <Style TargetType="Expander">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
    </Style>

    <!-- Şablonu yerleşik hâline döndürmek yeterli; bu tipler Foreground taşımıyor
         ya da miras alıyor. -->
    <Style TargetType="ScrollViewer" />
    <Style TargetType="TextBlock" />
    <Style TargetType="Window" />

</ResourceDictionary>
