<UserControl x:Class="WinOptimizer.App.Views.Management.ModulesTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:p="clr-namespace:WinOptimizer.App.Resources">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Orientation="Vertical" MaxWidth="760">

            <ui:Card Margin="0,0,0,12">
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="{x:Static p:Strings.ModulesTitle}" FontWeight="SemiBold"
                               FontSize="15" Margin="0,0,0,4"
                               AutomationProperties.HeadingLevel="Level2" />
                    <TextBlock Text="{x:Static p:Strings.ModulesDescription}" Opacity="0.7"
                               TextWrapping="Wrap" Margin="0,0,0,12" />

                    <ItemsControl ItemsSource="{Binding Modules}" Margin="0,0,0,12">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsEnabled}" Margin="0,3,0,7">
                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap" />
                                        <TextBlock Opacity="0.65" FontSize="11">
                                            <Run Text="{Binding Id, Mode=OneWay}" />
                                            <Run Text=" · risk: " />
                                            <Run Text="{Binding RiskBadge, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Orientation="Horizontal">
                        <ui:Button Content="{x:Static p:Strings.SettingsSave}"
                                   Command="{Binding SaveCommand}" Appearance="Primary"
                                   Margin="0,0,8,0" />
                        <ui:Button Content="{x:Static p:Strings.ModulesResetSafe}"
                                   Command="{Binding ResetToSafeDefaultCommand}" Appearance="Secondary"
                                   Margin="0,0,8,0" />
                        <ui:Button Content="{x:Static p:Strings.ModulesSelectAll}"
                                   Command="{Binding SelectAllCommand}" Appearance="Secondary" />
                    </StackPanel>
                </StackPanel>
            </ui:Card>

            <ui:InfoBar Title="{x:Static p:Strings.Result}" Message="{Binding StatusMessage}"
                        IsOpen="{Binding HasStatus}" Severity="Informational" />

        </StackPanel>
    </ScrollViewer>
</UserControl>
