<UserControl x:Class="WinOptimizer.App.Views.Management.GuardTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:p="clr-namespace:WinOptimizer.App.Resources">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Orientation="Vertical" MaxWidth="720">

            <ui:Card Margin="0,0,0,12">
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="{x:Static p:Strings.GuardTitle}" FontWeight="SemiBold" FontSize="15"
                               Margin="0,0,0,4" AutomationProperties.HeadingLevel="Level2" />
                    <TextBlock Text="{x:Static p:Strings.GuardDescription}" Opacity="0.7"
                               TextWrapping="Wrap" Margin="0,0,0,12" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="{x:Static p:Strings.GuardStateLabel}" Width="80"
                                   VerticalAlignment="Center" />
                        <ui:Badge Appearance="Secondary">
                            <TextBlock Text="{Binding StateText}"
                                       AutomationProperties.LiveSetting="Polite" />
                        </ui:Badge>
                        <ui:Button Content="{x:Static p:Strings.OverviewRefresh}"
                                   Command="{Binding RefreshStateCommand}"
                                   Appearance="Secondary" Margin="12,0,0,0" />
                    </StackPanel>

                    <!-- Servis exe'si yoksa tüm eylemler kapalı ve eksik dosyanın yolu gösterilir:
                         "en iyi tahmin" yolla işlem denemek sessiz başarısızlık üretir. -->
                    <ui:InfoBar Severity="Error" IsClosable="False"
                                Title="{x:Static p:Strings.GuardExeMissing}"
                                Message="{Binding ServiceExePath}"
                                IsOpen="{Binding IsServiceExeMissing}"
                                Margin="0,0,0,12" />

                    <StackPanel Orientation="Horizontal">
                        <ui:Button Content="{x:Static p:Strings.GuardInstall}"
                                   Command="{Binding InstallCommand}" IsEnabled="{Binding CanInstall}"
                                   Appearance="Primary" Margin="0,0,8,0" />
                        <ui:Button Content="{x:Static p:Strings.GuardStart}"
                                   Command="{Binding StartCommand}" IsEnabled="{Binding CanStart}"
                                   Appearance="Secondary" Margin="0,0,8,0" />
                        <ui:Button Content="{x:Static p:Strings.GuardStop}"
                                   Command="{Binding StopCommand}" IsEnabled="{Binding CanStop}"
                                   Appearance="Secondary" Margin="0,0,8,0" />
                        <ui:Button Content="{x:Static p:Strings.GuardRepair}"
                                   Command="{Binding RepairCommand}" IsEnabled="{Binding CanModify}"
                                   Appearance="Secondary" Margin="0,0,8,0" />
                        <ui:Button Content="{x:Static p:Strings.GuardUninstall}"
                                   Command="{Binding UninstallCommand}" IsEnabled="{Binding CanModify}"
                                   Appearance="Caution" />
                    </StackPanel>

                    <ui:ProgressRing IsIndeterminate="True" Width="24" Height="24"
                                     HorizontalAlignment="Left" Margin="0,12,0,0"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
            </ui:Card>

            <ui:Card Margin="0,0,0,12">
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="{x:Static p:Strings.GuardAutoTitle}" FontWeight="SemiBold"
                               Margin="0,0,0,4" AutomationProperties.HeadingLevel="Level2" />
                    <TextBlock Text="{x:Static p:Strings.GuardAutoDescription}" Opacity="0.7"
                               TextWrapping="Wrap" Margin="0,0,0,12" />

                    <ui:ToggleSwitch Content="{x:Static p:Strings.SettingsGuardEnabled}"
                                     IsChecked="{Binding GuardEnabled}" Margin="0,0,0,10" />

                    <!-- Otomatik müdahale VARSAYILAN KAPALI: LocalSystem yetkisiyle çalışan
                         bir servisin kullanıcıya sormadan dosya silmesi açık onay ister. -->
                    <CheckBox Content="{x:Static p:Strings.GuardAutoRemediate}"
                              IsChecked="{Binding AutoRemediate}" Margin="0,0,0,6" />
                    <CheckBox Content="{x:Static p:Strings.GuardAutoTrimRam}"
                              IsChecked="{Binding AutoTrimRam}" IsEnabled="{Binding AutoRemediate}"
                              Margin="20,0,0,4" />
                    <CheckBox Content="{x:Static p:Strings.GuardAutoCleanDisk}"
                              IsChecked="{Binding AutoCleanDiskCritical}" IsEnabled="{Binding AutoRemediate}"
                              Margin="20,0,0,4" />
                    <CheckBox Content="{x:Static p:Strings.GuardAutoDefender}"
                              IsChecked="{Binding AutoUpdateDefenderSignatures}" IsEnabled="{Binding AutoRemediate}"
                              Margin="20,0,0,12" />

                    <ui:Button Content="{x:Static p:Strings.SettingsSave}"
                               Command="{Binding SaveSettingsCommand}" Appearance="Primary"
                               HorizontalAlignment="Left" />
                </StackPanel>
            </ui:Card>

            <ui:InfoBar Title="{x:Static p:Strings.Result}" Message="{Binding StatusMessage}"
                        IsOpen="{Binding HasStatus}" Severity="Informational" />

        </StackPanel>
    </ScrollViewer>
</UserControl>
