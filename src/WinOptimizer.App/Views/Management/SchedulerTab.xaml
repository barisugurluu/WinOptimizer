<UserControl x:Class="WinOptimizer.App.Views.Management.SchedulerTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:p="clr-namespace:WinOptimizer.App.Resources">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Orientation="Vertical" MaxWidth="720">

            <ui:Card Margin="0,0,0,12">
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="{x:Static p:Strings.SchedulerWeekly}" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,4"
                               AutomationProperties.HeadingLevel="Level2" />
                    <TextBlock Text="{x:Static p:Strings.SchedulerWeeklyDesc}" Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,12" />

                    <ui:ToggleSwitch Content="{x:Static p:Strings.SchedulerEnable}" IsChecked="{Binding WeeklyEnabled}" Margin="0,0,0,12" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="{x:Static p:Strings.SchedulerDay}" Width="80" VerticalAlignment="Center" />
                        <ComboBox ItemsSource="{Binding Days}" SelectedItem="{Binding SelectedDay}" MinWidth="160" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="{x:Static p:Strings.SchedulerTime}" Width="80" VerticalAlignment="Center" />
                        <ui:TextBox Text="{Binding SelectedTime, UpdateSourceTrigger=PropertyChanged}" MinWidth="120" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,12">
                        <TextBlock Text="{x:Static p:Strings.SchedulerCliPath}" Width="80" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding CliPath}" Opacity="0.6" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <ui:Button Content="{x:Static p:Strings.SchedulerCreate}" Command="{Binding CreateTaskCommand}"
                                   Appearance="Primary" Margin="0,0,8,0" />
                        <ui:Button Content="{x:Static p:Strings.SchedulerDelete}" Command="{Binding DeleteTaskCommand}"
                                   Appearance="Caution" Margin="0,0,8,0" />
                        <ui:Button Content="{x:Static p:Strings.OverviewRefresh}" Command="{Binding RefreshCommand}" Appearance="Secondary" />
                    </StackPanel>
                </StackPanel>
            </ui:Card>

            <ui:Card Margin="0,0,0,12">
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="{x:Static p:Strings.SchedulerTaskStatus}" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBlock Text="{Binding TaskStatusText}" TextWrapping="Wrap" />
                </StackPanel>
            </ui:Card>

            <ui:InfoBar Title="{x:Static p:Strings.Result}" Message="{Binding StatusMessage}"
                        IsOpen="{Binding HasStatus}" Severity="Informational" />

        </StackPanel>
    </ScrollViewer>
</UserControl>