<UserControl x:Class="WinOptimizer.App.Views.Management.SystemDataTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:p="clr-namespace:WinOptimizer.App.Resources">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Orientation="Vertical" MaxWidth="760">

            <ui:Card Margin="0,0,0,12">
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="{x:Static p:Strings.RequirementsTitle}" FontWeight="SemiBold"
                               FontSize="15" Margin="0,0,0,4"
                               AutomationProperties.HeadingLevel="Level2" />
                    <TextBlock Text="{x:Static p:Strings.RequirementsDescription}" Opacity="0.7"
                               TextWrapping="Wrap" Margin="0,0,0,12" />

                    <ItemsControl ItemsSource="{Binding Requirements}" Margin="0,0,0,12">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3,0,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Glyph}" FontSize="14"
                                               FontWeight="Bold" VerticalAlignment="Top" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Detail}" Opacity="0.75" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding RemedyHint}" TextWrapping="Wrap"
                                                   FontStyle="Italic" Margin="0,2,0,0"
                                                   Visibility="{Binding HasRemedy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Orientation="Horizontal">
                        <ui:Button Content="{x:Static p:Strings.RequirementsRecheck}"
                                   Command="{Binding RunCheckCommand}" Appearance="Secondary"
                                   Margin="0,0,8,0" />
                        <ui:Button Content="{x:Static p:Strings.DiagnosticsExport}"
                                   Command="{Binding ExportDiagnosticsCommand}" Appearance="Primary" />
                    </StackPanel>
                </StackPanel>
            </ui:Card>

            <ui:InfoBar Title="{x:Static p:Strings.DiagnosticsPackage}" Message="{Binding StatusMessage}"
                        IsOpen="{Binding HasStatus}" Severity="Informational" />

        </StackPanel>
    </ScrollViewer>
</UserControl>
