<Page x:Class="WinOptimizer.App.Views.RollbackPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:p="clr-namespace:WinOptimizer.App.Resources"
      Title="{x:Static p:Strings.Rollback}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{x:Static p:Strings.RollbackTimelineTitle}"
                   FontSize="28" FontWeight="SemiBold" Margin="0,0,0,12"
                   AutomationProperties.HeadingLevel="Level1" />

        <TextBlock Grid.Row="1" Text="{Binding StatusText}" Opacity="0.7" Margin="0,0,0,12" />

        <!-- Değişiklik kart listesi (Bölüm 12.3 Akış C) -->
        <ListView Grid.Row="2" ItemsSource="{Binding Records}" Background="Transparent" BorderThickness="0"
                  AutomationProperties.Name="{x:Static p:Strings.RollbackTimelineTitle}"
                  AutomationProperties.HelpText="{x:Static p:Strings.RollbackListHelpText}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <ui:Card Margin="0,0,0,8">
                        <StackPanel Orientation="Vertical">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Timestamp}" FontWeight="SemiBold" Margin="0,0,12,0" />
                                <TextBlock Text="{Binding Module}" Foreground="#5B5FC7" Margin="0,0,12,0" />
                                <TextBlock Text="{Binding Operation}" Opacity="0.6" />
                            </StackPanel>
                            <TextBlock Text="{Binding Target}" TextTrimming="CharacterEllipsis"
                                       Margin="0,4,0,0" Opacity="0.8" />
                            <TextBlock Text="{Binding Note}" TextWrapping="Wrap"
                                       Margin="0,2,0,0" Opacity="0.6" FontSize="12" />
                        </StackPanel>
                    </ui:Card>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
