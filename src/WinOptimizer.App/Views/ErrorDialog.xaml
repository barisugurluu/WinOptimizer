<!--
  Bilinçli olarak DÜZ System.Windows.Window ve SİSTEM RENKLERİ kullanılır — ui:FluentWindow DEĞİL.
  Sebep: olası başlangıç hatalarından biri App.xaml'deki WPF-UI ThemesDictionary/ControlsDictionary
  birleştirmesinin kendisidir. O durumda FluentWindow tabanlı bir hata penceresi, hatayı
  bildirirken kendisi de patlar ve kullanıcı yine hiçbir şey görmez.
  DynamicResource SystemColors.* High Contrast temasında da doğru okunur.

  BOYUTLANDIRMA — SizeToContent+MaxHeight KULLANILMAZ: Windows Sandbox'ta canlı doğrulandı,
  bu ikili WPF'te güvenilir çalışmıyor — uzun bir istisna/yığın izinde pencere MaxHeight'i
  aşan içerikle karşılaşınca düzgün küçülmüyor, "Kapat" düğmesi dahil alt satır görünür
  alanın tamamen dışında kalabiliyor (bir hata penceresinin KENDİSİ kapatılamaz hale geliyordu).
  Bunun yerine SABİT yükseklik + iki satırlı Grid (Row0="*" TEK ScrollViewer içinde tüm
  değişken içerik, Row1="Auto" düğme çubuğu) kullanılır — bkz. FirstRunWindow.xaml.
-->
<Window x:Class="WinOptimizer.App.Views.ErrorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinOptimizer — Hata"
        Width="640" Height="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="True"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
        Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}">
    <Window.Resources>
        <!-- ZORUNLU: pencere sistem renklerini zorluyor; bu olmadan WPF-UI'ın
             ControlsDictionary'si düğme/TextBox/Expander yazılarını BEYAZ yapar ve
             beyaz zeminde görünmez olurlar — bir HATA penceresinin "Kapat" düğmesinin
             okunamaması özellikle kötüdür. Ayrıntı sözlüğün kendi başlığında. -->
        <!-- Derleme-nitelikli URI ŞART: bkz. FirstRunWindow.xaml. -->
        <ResourceDictionary Source="pack://application:,,,/WinOptimizer.App;component/Resources/SystemChromeDictionary.xaml" />
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Başlıktan teknik ayrıntılara kadar HER ŞEY tek bir kaydırılabilir alanda.
             Düğme çubuğu (Row 1) bunun dışında ve her zaman garanti alan alır — bir hata
             penceresinin "Kapat" düğmesi asla erişilemez olmamalı. -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,12,0">
                <TextBlock x:Name="HeadlineText"
                           FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"
                           Margin="0,0,0,8"
                           AutomationProperties.HeadingLevel="Level1" />

                <TextBlock x:Name="SummaryText"
                           TextWrapping="Wrap" Margin="0,0,0,12" />

                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="Günlük ve rapor konumları:" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <!-- Seçilebilir: kullanıcı yolu kopyalayıp destek mesajına yapıştırabilsin.
                         Foreground/Background el yaması KALDIRILDI: aynı hatanın tek kontrole
                         uygulanmış hâliydi, artık SystemChromeDictionary tümünü kapsıyor. -->
                    <TextBox x:Name="PathsText" IsReadOnly="True" TextWrapping="Wrap"
                             BorderThickness="0" />
                </StackPanel>

                <Expander Header="Teknik ayrıntılar" Margin="0,0,0,12">
                    <TextBox x:Name="DetailsText" IsReadOnly="True"
                             FontFamily="Consolas" FontSize="11"
                             TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             MaxHeight="260" Margin="0,8,0,0" />
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="OpenLogsButton" Content="Günlük klasörünü aç"
                    MinWidth="150" Margin="0,0,8,0" Padding="10,5"
                    Click="OnOpenLogs" />
            <Button x:Name="DiagnosticsButton" Content="Teşhis paketi oluştur"
                    MinWidth="150" Margin="0,0,8,0" Padding="10,5"
                    Click="OnCreateDiagnostics" />
            <Button x:Name="CloseButton" Content="Kapat" IsDefault="True" IsCancel="True"
                    MinWidth="90" Padding="10,5" Click="OnClose" />
        </StackPanel>
    </Grid>
</Window>
