<Application x:Class="WinOptimizer.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Startup="OnStartup"
             Exit="OnExit">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Tüm uygulama kaynakları Resources/AppResources.xaml içindedir.
                     Burada tanım YAPILMAZ: dev/WinOptimizer.UiPreview aracı da aynı
                     dosyayı merge ediyor; kaynakları burada tutmak ikisinin
                     sürüklenmesine ve önizlemenin yanlış güven vermesine yol açardı. -->
                <ResourceDictionary Source="pack://application:,,,/WinOptimizer.App;component/Resources/AppResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
