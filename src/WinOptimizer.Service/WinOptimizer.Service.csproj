<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>WinOptimizer.Service</RootNamespace>
    <OutputType>Exe</OutputType>
    <UseWPF>false</UseWPF>
    <Description>RealtimeGuard — arka plan Windows servisi; eşik tabanlı otomatik müdahale (master plan Bölüm 3.17).</Description>
    <AssemblyName>WinOptimizer.Service</AssemblyName>
    <!-- App ile aynı ikon: Hizmetler/Görev Yöneticisi listesinde tanınabilir olsun. -->
    <ApplicationIcon>..\WinOptimizer.App\Resources\WinOptimizer.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.0" />
    <PackageReference Include="System.Management" Version="8.0.0" />
    <!-- ServiceInstaller: servis varlığı/durumu yerelleştirmeden bağımsız sorgulanır
         (sc query çıktısını ayrıştırmak TR/EN Windows'ta kırılgan). -->
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.0" />
    <!-- Dosya günlüğü köprüsü (Safety/Diagnostics/LoggingBootstrap). Sürüm App ile aynı. -->
    <PackageReference Include="Serilog.Extensions.Logging" Version="8.0.0" />
    <!-- GuardIpcServer: named pipe DACL'i (yalnız SYSTEM + Administrators). -->
    <PackageReference Include="System.IO.Pipes.AccessControl" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- ServiceInstaller'ın sc.exe argüman kurucuları test edilir (Safety'deki desenle aynı). -->
    <InternalsVisibleTo Include="WinOptimizer.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WinOptimizer.Core\WinOptimizer.Core.csproj" />
    <ProjectReference Include="..\WinOptimizer.Native\WinOptimizer.Native.csproj" />
    <ProjectReference Include="..\WinOptimizer.Safety\WinOptimizer.Safety.csproj" />
    <!-- GuardSettingsProvider: settings.json şeması (AppSettings) tek kaynaktan okunur.
         Servise ayrı bir DTO yazmak, arayüzün yazdığı ile servisin okuduğu şemanın
         zamanla ayrışması demekti. Döngü yok: Orchestration → Safety → Core.
         NOT: bu referans publish ağacını değiştirir; build-installer.ps1 sağlık
         kontrolü her değişiklikten sonra yeniden koşmalıdır. -->
    <ProjectReference Include="..\WinOptimizer.Orchestration\WinOptimizer.Orchestration.csproj" />
  </ItemGroup>

</Project>
