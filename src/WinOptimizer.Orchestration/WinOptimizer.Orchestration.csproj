<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>WinOptimizer.Orchestration</RootNamespace>
    <UseWPF>false</UseWPF>
    <Description>JobOrchestrationEngine — modülleri paralel, iptal edilebilir şekilde koordine eder.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.1" />
    <!-- Preflight/SystemRequirementsChecker: WMI erişilebilirlik yoklaması. -->
    <PackageReference Include="System.Management" Version="8.0.0" />
    <!-- GuardServiceController: servis durumu/başlat/durdur (yerelleştirmeden bağımsız). -->
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.0" />
    <!-- DiagnosticsPackageBuilder: EventLog'a yazan (eski) sürümlerden gelen servis
         kayıtlarını da teşhis paketine alabilmek için. -->
    <PackageReference Include="System.Diagnostics.EventLog" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WinOptimizer.Core\WinOptimizer.Core.csproj" />
    <ProjectReference Include="..\WinOptimizer.Safety\WinOptimizer.Safety.csproj" />
  </ItemGroup>

</Project>
