<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>WinOptimizer.Cli</RootNamespace>
    <Description>Komut satırı arayüzü — optimize, analyze, clean, rollback (master plan Bölüm 15).</Description>
    <AssemblyName>WinOptimizer.Cli</AssemblyName>
    <!-- App ile aynı ikon: Görev Yöneticisi'nde ve zamanlanmış görev listesinde tanınabilir olsun. -->
    <ApplicationIcon>..\WinOptimizer.App\Resources\WinOptimizer.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="8.0.0" />
    <!-- Dosya günlüğü köprüsü (Safety/Diagnostics/LoggingBootstrap) — zamanlanmış
         gözetimsiz çalışmaların izi kalsın. Sürüm App/Service ile aynı. -->
    <PackageReference Include="Serilog.Extensions.Logging" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WinOptimizer.Core\WinOptimizer.Core.csproj" />
    <ProjectReference Include="..\WinOptimizer.Safety\WinOptimizer.Safety.csproj" />
    <ProjectReference Include="..\WinOptimizer.Orchestration\WinOptimizer.Orchestration.csproj" />
    <ProjectReference Include="..\WinOptimizer.Modules\CleanEngine\WinOptimizer.Modules.CleanEngine.csproj" />
    <ProjectReference Include="..\WinOptimizer.Modules\MemoryEngine\WinOptimizer.Modules.MemoryEngine.csproj" />
    <ProjectReference Include="..\WinOptimizer.Modules\RepairEngine\WinOptimizer.Modules.RepairEngine.csproj" />
    <ProjectReference Include="..\WinOptimizer.Modules\SystemTweaker\WinOptimizer.Modules.SystemTweaker.csproj" />
    <ProjectReference Include="..\WinOptimizer.Modules\BenchmarkEngine\WinOptimizer.Modules.BenchmarkEngine.csproj" />
    <ProjectReference Include="..\WinOptimizer.Updater\WinOptimizer.Updater.csproj" />
  </ItemGroup>

</Project>
