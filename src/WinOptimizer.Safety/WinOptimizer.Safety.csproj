<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>WinOptimizer.Safety</RootNamespace>
    <UseWindowsForms>false</UseWindowsForms>
    <UseWPF>false</UseWPF>
    <Description>SafetyNet: Sistem Geri Yükleme noktası, change journal, registry yedekleme, beyaz liste.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.1" />
    <PackageReference Include="System.Management" Version="8.0.0" />
    <!-- HMAC bütünlük doğrulaması — journal/reg yedek kurcalanmasına karşı (master plan §17.4). -->
    <PackageReference Include="System.IO.Hashing" Version="8.0.0" />
    <!-- DPAPI ayar/gizli şifreleme — System.Security.Cryptography.ProtectedData (master plan §17). -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <!-- Dayanıklılık: geçici hatalarda retry + circuit-breaker (master plan §18.1/§19). -->
    <PackageReference Include="Polly" Version="8.4.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WinOptimizer.Core\WinOptimizer.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WinOptimizer.Core.Tests" />
  </ItemGroup>
</Project>
