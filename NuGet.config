<?xml version="1.0" encoding="utf-8"?>
<!--
  Paket kaynakları bilinçli olarak yalnız nuget.org'a sabitlenmiştir.
  <clear /> olmadan, kurumsal bir makinedeki makine-seviyesi feed'ler devreye girer ve
  restore farklı paketler çözebilir (deterministic derleme garantisi bozulur).
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
